# Copy to .env for local development. Never commit the real .env.
# See docs/DEVELOPMENT.md and docs/SECURITY.md §5 for production secret handling.

NODE_ENV=development

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://app:app@localhost:5432/appdb?schema=public
# Role Postgres connects as for RLS enforcement (must NOT have BYPASSRLS).
DATABASE_APP_ROLE=app

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API server -------------------------------------------------------
API_PORT=3000
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Appointment engine -------------------------------------------------
DEFAULT_HOLD_TTL_MINUTES=15
DEFAULT_NO_SHOW_GRACE_MINUTES=30

# --- Email (dev: MailHog) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@example.com

# --- WhatsApp Business Cloud API (docs/WHATSAPP.md) ----------------------
# App secret used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=dev-only-whatsapp-app-secret
# Shared secret Meta echoes back during the webhook GET verification handshake.
WHATSAPP_VERIFY_TOKEN=dev-only-verify-token
# Leave unset in local dev: apps/worker falls back to a simulated send
# client (logs instead of calling the real Cloud API) when this is empty.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
