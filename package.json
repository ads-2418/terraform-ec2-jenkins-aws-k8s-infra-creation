{
  "name": "healthcare-appointment-saas",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:concurrency": "pnpm --filter @app/domain-appointment test:concurrency",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate:dev": "pnpm --filter @app/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @app/db migrate:deploy",
    "db:seed": "pnpm --filter @app/db seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
